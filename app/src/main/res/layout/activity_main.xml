<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="#D6E4FF"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestión de Combustible"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#0D47A1" />

        </LinearLayout>

        <!-- GRID DE ROLES -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="4">

            <!-- ADMIN FLOTA -->
            <LinearLayout
                android:id="@+id/btnAdminFlota"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:layout_margin="8dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/admin_flota"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Administrador de flota"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:gravity="center" />
            </LinearLayout>

            <!-- ALMACÉN -->
            <LinearLayout
                android:id="@+id/btnAlmacen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:layout_margin="8dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/almacen"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Encargado de almacén"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:gravity="center" />
            </LinearLayout>

            <!-- DISTRIBUIDOR -->
            <LinearLayout
                android:id="@+id/btnDistribuidor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:layout_margin="8dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/distribuidor"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distribuidor mayorista"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:gravity="center" />
            </LinearLayout>

            <!-- GERENTE -->
            <LinearLayout
                android:id="@+id/btnGerente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:layout_margin="8dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/gerente"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gerente operativo"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:gravity="center" />
            </LinearLayout>

            <!-- COMPRADOR -->
            <LinearLayout
                android:id="@+id/btnComprador"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:layout_margin="8dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/comprador"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usuario comprador"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:gravity="center" />
            </LinearLayout>

            <!-- ADMIN SISTEMA -->
            <LinearLayout
                android:id="@+id/btnAdminSistema"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:layout_margin="8dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/admin_sistema"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Administrador del sistema"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:gravity="center" />
            </LinearLayout>

            <!-- ANALISTA -->
            <LinearLayout
                android:id="@+id/btnAnalista"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:layout_margin="8dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/analista"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analista de operaciones"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:gravity="center" />
            </LinearLayout>

            <!-- ESTACION SERVICIO -->
            <LinearLayout
                android:id="@+id/btnEstacionServicio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:layout_margin="8dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/estacion_servicio"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estación servicio"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:gravity="center" />
            </LinearLayout>

            <!-- LABORATORIO REST -->
            <LinearLayout
                android:id="@+id/btnRest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:layout_margin="8dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/rest_api"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Laboratorio REST"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:gravity="center" />

            </LinearLayout>

        </GridLayout>

    </LinearLayout>

</ScrollView>