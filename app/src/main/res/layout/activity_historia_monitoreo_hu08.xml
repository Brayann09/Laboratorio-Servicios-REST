<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestión de Combustible"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnHistoriaHU08"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HistoriaMonitoreoHU08"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/layoutMenuHU08"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnCalcularConsumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calcular consumo por kilómetro"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnMostrarRanking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mostrar ranking de vehículos"
                android:layout_marginBottom="20dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutCalculoConsumo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calcular consumo por kilómetro"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etPlaca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Placa del vehículo" />

            <EditText
                android:id="@+id/etKilometros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Kilómetros recorridos"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/etCombustible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Combustible consumido"
                android:inputType="numberDecimal" />

            <Button
                android:id="@+id/btnCalcular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calcular consumo"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRankingVehiculos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mostrar ranking de vehículos"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnVerRanking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ver ranking de vehículos" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResultadoHU08"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aquí se mostrarán los resultados de la HU08."
            android:textSize="16sp"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>