<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Titulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestión de Inventario HU10"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="20dp"/>

        <!-- Combustible -->
        <EditText
            android:id="@+id/editCombustible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tipo de combustible"/>

        <!-- Cantidad -->
        <EditText
            android:id="@+id/editCantidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cantidad"
            android:inputType="numberDecimal"/>

        <!-- Movimiento -->
        <EditText
            android:id="@+id/editMovimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entrada o salida"/>

        <!-- Boton -->
        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar Movimiento"
            android:layout_marginTop="15dp"/>

        <!-- Historial -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Historial de movimientos"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingTop="25dp"/>

        <!-- Resultado -->
        <TextView
            android:id="@+id/textHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay movimientos registrados"/>

    </LinearLayout>

</ScrollView>