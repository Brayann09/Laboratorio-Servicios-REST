<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HU05 - Asignación de combustible"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etPlacaVehiculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Placa del vehículo" />

        <EditText
            android:id="@+id/etCupoCombustible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cupo de combustible"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnAsignarCupo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asignar cupo"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/tvResultadoHU05"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aquí se mostrará el resultado de la asignación."
            android:textSize="16sp"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>