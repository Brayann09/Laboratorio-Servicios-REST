        <activity android:name=".roles.comprador.AplicacionPreciosSubsidiosActivityHU04" />
        <activity android:name="roles.adminflota.AsignacionCombustibleActivityHU05" />
        <activity android:name=".roles.comprador.HistorialComprasActivityHU09" />
        <activity android:name=".roles.adminsistema.HistoriaConfiguracionHU06" />
